generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model BoardGame {
  id              String   @id @default(cuid())
  name            String
  description     String
  imageUrl        String
  minAge          Int
  maxAge          Int
  minPlayers      Int
  maxPlayers      Int
  pathologyTags   String[]
  psychomotorTags String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
