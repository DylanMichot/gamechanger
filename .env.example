# Base de données PostgreSQL via Supabase
# Mode connection pooling (port 6543) - utilisé par Prisma à runtime
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Connexion directe (port 5432) - utilisée par Prisma pour les migrations
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# NextAuth.js
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=votre_secret_nextauth_ici
NEXTAUTH_URL=http://localhost:3000

# Emails autorisés pour l'accès admin (un email par variable)
ADMIN_EMAIL=email-admin@exemple.com
TEAM_EMAIL=email-team@exemple.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_anon_key_supabase
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key_supabase
